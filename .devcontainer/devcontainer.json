{
  "name": "Modified BioConductor Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
    }
  },
  "features": {
    "ghcr.io/MiguelRodo/DevContainerFeatures/cmdstan:1": {
      "version": "latest"
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/utils:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "xvfb,vim,libcurl4-openssl-dev,libsecret-1-dev,jq"
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "installTinyTex": true
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/renv-cache:1": {
      "update": true,
      "pkg": "bioc::flowWorkspace, bioc::MIMOSA, RGLab/MIMOSA2",
      "createUnifiedLockfile": "true",
      "purgePostUnification": "keep-one"
    }
  }
}
