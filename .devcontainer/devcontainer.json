{
  "name": "BioConductor Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/MiguelRodo/DevContainerFeatures/build-info:1": {},
    "ghcr.io/MiguelRodo/DevContainerFeatures/renv-cache:1": {
      "debug": true,
      "debugRenv": true
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/utils:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "xvfb,vim,libcurl4-openssl-dev,libsecret-1-dev,jq,qpdf"
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "installTinyTex": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "Posit.air-vscode",
        "mathematic.vscode-pdf"
      ]
    }
  }
}
