{
  "name": "projcli development and renderer diagnostics",
  "build": { "dockerfile": "Dockerfile" },
  "containerUser": "rstudio",
  "remoteUser": "rstudio",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "rstudio",
      "installZsh": false,
      "upgradePackages": false,
      "installSsl": false
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/build-info:1.4.0": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "build-essential,pkg-config,libssl-dev,python3,python3-venv,git,curl,jq,qpdf,poppler-utils"
    },
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "knitr,rmarkdown",
      "cranMirror": "https://cloud.r-project.org"
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "1.10.19",
      "installTinyTex": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "quarto.quarto", "mathematic.vscode-pdf"]
    }
  }
}
